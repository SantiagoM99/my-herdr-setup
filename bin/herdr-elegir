#!/bin/zsh
# Lista los archivos de la carpeta que cumplen los patrones (recientes primero), deja elegir
# uno con fzf e imprime su ruta. Ignora carpetas ocultas, .venv y node_modules.
#   herdr-elegir 'PROMPT> ' '*.csv' '*.parquet'
PROMPT=$1; shift
ARGS=()
for pat in "$@"; do ARGS+=(-o -name "$pat"); done
ARGS=("${(@)ARGS[2,-1]}")
LISTA=$(find . \( -path '*/.*' -o -path './.venv' -o -path '*/node_modules' \) -prune -o \
  -type f \( "${ARGS[@]}" \) -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null)
[[ -z $LISTA ]] && { echo "No hay $* en $PWD" >&2; sleep 2; exit 1; }
print -r -- $LISTA | fzf --prompt="$PROMPT" --height=100%
