#!/bin/zsh
# Finds a file under the current directory and opens it with herdr-open, by type.
# Starts with file names, newest first; Ctrl+T switches to searching contents (ripgrep), where
# Enter opens the file at the matching line. Ignored files are included (outputs are often
# gitignored); hidden directories, node_modules, venv and __pycache__ are not.
# Used by prefix+a (pane, via herdr-side) and prefix+shift+a (popup).
export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH
SELF=${0:A}
SKIP=(node_modules venv __pycache__)

case $1 in
  --names)
    # Directory dimmed, file name in full color.
    fd --type f --no-ignore --strip-cwd-prefix ${SKIP/#/--exclude=} -0 | xargs -0 stat -f '%m %N' 2>/dev/null \
      | sort -rn | cut -d' ' -f2- \
      | awk '{ i = match($0, /[^\/]*$/); printf "\033[2m%s\033[0m%s\n", substr($0, 1, i - 1), substr($0, i) }'
    exit ;;
  --contents)
    [[ -z $2 ]] && exit 0
    rg --line-number --no-heading --color=always --smart-case --no-ignore --max-columns=200 \
      ${SKIP/#/--glob=!} -- "$2"
    exit 0 ;;
esac

# The input label names the mode; Ctrl+T and Enter read it to decide what to do.
NAMES="reload($SELF --names)+unbind(change)+enable-search+change-input-label( Files )+change-ghost(name  ·  Ctrl+T: contents)"
CONTENTS="reload($SELF --contents {q})+rebind(change)+disable-search+change-input-label( Contents )+change-ghost(text  ·  Ctrl+T: names)"
exec fzf --ansi --delimiter=: --layout=reverse --info=inline-right --highlight-line \
  --input-border=rounded --list-border=rounded --prompt='❯ ' --color='label:bold,ghost:dim' \
  --bind="start:$NAMES" \
  --bind="change:reload:$SELF --contents {q}" \
  --bind="ctrl-t:transform:[[ \$FZF_INPUT_LABEL == *Files* ]] && echo '$CONTENTS' || echo '$NAMES'" \
  --bind="enter:transform:[[ \$FZF_INPUT_LABEL == *Files* ]] && echo 'become(herdr-open {})' || echo 'become(herdr-open {1} {2})'"
