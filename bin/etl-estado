#!/bin/zsh
# Una línea para la barra de Herdr: ¿está el ETL de Observatory-Data-Flow escribiendo los parquets?
# CLAUDE.md pide comprobarlo antes de regenerar datasets o correr experimentos.
# Sin la carpeta del ETL (otra máquina) no imprime nada y la barra queda limpia.
DIR=${ETL_DIR:-$HOME/Projects/NES/Observatory-Data-Flow/data/processed}
[[ -d $DIR ]] || exit 0
if pgrep -f run_etl.py >/dev/null; then echo "⚠ ETL corriendo"; exit; fi
ULT=$(find "$DIR" -type f -name '*.parquet' -mmin -15 2>/dev/null | head -1)
[[ -n $ULT ]] && { echo "⚠ ETL escribió hace <15 min"; exit; }
echo "ETL quieto"
