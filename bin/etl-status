#!/bin/zsh
# One line for the Herdr tab bar: is the Observatory-Data-Flow ETL writing its parquets?
# Regenerating datasets or running experiments while it writes mixes snapshots.
# Without the ETL directory (another machine) it prints nothing and the bar stays clean.
DIR=${ETL_DIR:-$HOME/Projects/NES/Observatory-Data-Flow/data/processed}
[[ -d $DIR ]] || exit 0
if pgrep -f run_etl.py >/dev/null; then echo "⚠ ETL running"; exit; fi
RECENT=$(find "$DIR" -type f -name '*.parquet' -mmin -15 2>/dev/null | head -1)
[[ -n $RECENT ]] && { echo "⚠ ETL wrote <15 min ago"; exit; }
echo "ETL idle"
